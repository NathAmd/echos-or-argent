# Valeurs publiques intégrées au build statique. Ne placez jamais de secret ici.
# Utilisez /nom-du-depot/ pour une project Page, ou / pour un domaine personnalisé.
POKEMASTER_PUBLIC_BASE_PATH=/
# Laisser vide pour la publication alpha solo.
POKEMASTER_PUBLIC_ONLINE_SERVER_URL=
# JSON public optionnel. Les credentials TURN présents ici seront lisibles dans le bundle.
# POKEMASTER_PUBLIC_RTC_ICE_SERVERS=[{"urls":["stun:stun.example.com:3478"]},{"urls":["turns:turn.example.com:5349?transport=tcp"],"username":"scoped-user","credential":"scoped-password"}]
