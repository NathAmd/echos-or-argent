# The container needs 0.0.0.0. Use 127.0.0.1 when running directly behind a local reverse proxy.
HOST=0.0.0.0
PORT=8787

# Exact browser CLIENT origins, comma-separated, without a path or trailing slash.
# This is not the public hostname of the server tunnel. Wildcards are rejected.
ALLOWED_ORIGINS=https://your-account.github.io
# Opt-in for locally served clients on any port. Only localhost, 127.0.0.1 and [::1] match.
ALLOW_LOOPBACK_ORIGINS=false
# Development only: accepts canonical private-IP client origins and defaults HOST to 0.0.0.0.
LAN_DEVELOPMENT_MODE=false

# Persistent accounts and server-side sessions. The browser never asks the user for a token.
ACCOUNT_STORE_PATH=./data/accounts.json
ACCOUNT_SESSION_TTL_MS=2592000000
# "open" enables the current test phase. Switch to "patreon" only when a provider is wired.
ACCOUNT_ENTITLEMENT_POLICY=open

# Optional migration/automation compatibility only. Omit for the account product flow.
# AUTH_TOKENS_JSON={"legacy-user":"REPLACE_WITH_A_64_CHARACTER_SHA256_HEX_DIGEST"}

FRIEND_STORE_PATH=./data/friends.json
# Separate directory for authenticated, client-encrypted opaque objects.
OBJECT_STORE_PATH=./data/objects
WS_TICKET_TTL_MS=30000
# A queued search and a stranger-signaling authorization are both ephemeral.
MATCHMAKING_QUEUE_TTL_MS=120000
MATCHMAKING_AUTHORIZATION_TTL_MS=120000
# File/offer/accept Coop durable. Both participants receive the same opaque sessionId.
COOP_RENDEZVOUS_TTL_MS=120000
COOP_RENDEZVOUS_STORE_PATH=./data/coop-rendezvous.json
# Temporary migration only. Disabled by default, including in LAN development.
# ALLOW_LEGACY_COOP_BOOTSTRAP=true
# An abandoned shared session survives brief reconnects, then releases its bounded slot.
SHARED_SESSION_IDLE_TTL_MS=86400000
# Atomic generic session state. Keep this file on the same persistent volume as the other server data.
SHARED_SESSION_STORE_PATH=./data/shared-sessions.json

# Deployment-only values (do not enter registry credentials here):
# SERVER_IMAGE=ghcr.io/your-account/your-repository-server:sha-<full-git-sha>
# NPM_NETWORK=nginx-proxy-manager_default
# Optional compose.tunnel.yaml values. The token is secret and must stay in the server-only .env.
# CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-remotely-managed-tunnel-token
# CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
