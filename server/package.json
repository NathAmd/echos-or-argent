{
  "name": "generic-social-signaling-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "account:admin": "node dist/account-admin.js",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
